<mvc:View controllerName="fis.mdsa.controller.Material"
  xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:uxap="sap.uxap" xmlns:form="sap.ui.layout.form"
  xmlns:core="sap.ui.core" xmlns:t="sap.ui.table" xmlns:trm="sap.ui.table.rowmodes"
  xmlns:ng="sap.suite.ui.commons.networkgraph" xmlns:ngl="sap.suite.ui.commons.networkgraph.layout" height="100%">
  <uxap:ObjectPageLayout id="page" showFooter="false" upperCaseAnchorBar="false" busy="{m>/busy}"
    busyIndicatorDelay="0" useIconTabBar="false" headerContentPinnable="true" toggleHeaderOnTitleClick="true">
    <uxap:headerTitle>
      <uxap:ObjectPageDynamicHeaderTitle>
        <uxap:breadcrumbs>
          <Breadcrumbs currentLocationText="Material {m>/matnr}">
            <Link text="Materialsuche" press=".onBack"/>
          </Breadcrumbs>
        </uxap:breadcrumbs>
        <uxap:expandedHeading>
          <Title text="{m>/text}" wrapping="true"/>
        </uxap:expandedHeading>
        <uxap:snappedHeading>
          <Title text="{m>/matnr} · {m>/text}" wrapping="true"/>
        </uxap:snappedHeading>
        <uxap:expandedContent>
          <Text text="Material {m>/matnr}"/>
        </uxap:expandedContent>
        <uxap:actions>
          <Button text="Dubletten prüfen" icon="sap-icon://compare" press=".onScrollToDuplicates"/>
          <Button text="An SAP senden" icon="sap-icon://upload-to-cloud" type="Emphasized" press=".onOpenSapDialog"/>
          <Button icon="sap-icon://decline" type="Transparent" tooltip="Schließen" press=".onBack"/>
        </uxap:actions>
      </uxap:ObjectPageDynamicHeaderTitle>
    </uxap:headerTitle>

    <uxap:headerContent>
      <FlexBox wrap="Wrap" fitContainer="true" alignItems="Start">
        <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
          <ObjectAttribute title="Materialart" text="{m>/mtart}"/>
          <ObjectAttribute title="Warengruppe" text="{m>/matkl}"/>
          <ObjectAttribute title="Basismengeneinheit" text="{m>/meins}"/>
        </VBox>
        <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
          <ObjectAttribute title="EAN" text="{= ${m>/ean} || '-' }"/>
          <ObjectAttribute title="Lieferanten" text="{= ${m>/vendors} &amp;&amp; ${m>/vendors}.length ? ${m>/vendors}.join(', ') : '-' }"/>
          <ObjectAttribute title="Klasse" text="{= ${m>/classes} &amp;&amp; ${m>/classes}.length ? ${m>/classes}.join(', ') : '-' }"/>
        </VBox>
        <VBox class="sapUiSmallMarginBottom">
          <ObjectStatus title="Status" text="{= ${m>/deleted} ? 'Löschvormerkung' : (${m>/status} ? 'Sperre ' + ${m>/status} : 'Aktiv') }"
            state="{= ${m>/deleted} ? 'Error' : (${m>/status} ? 'Warning' : 'Success') }" inverted="true"/>
        </VBox>
      </FlexBox>
    </uxap:headerContent>

    <uxap:sections>
      <uxap:ObjectPageSection title="Allgemein" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="Grunddaten (MARA)" titleUppercase="false">
            <form:SimpleForm id="generalForm" editable="false" layout="ColumnLayout" columnsM="2" columnsL="3" columnsXL="3"/>
          </uxap:ObjectPageSubSection>
          <uxap:ObjectPageSubSection title="Alle befüllten MARA-Felder" titleUppercase="false">
            <Table items="{path: 'm>/maraFields', templateShareable: false}" growing="true" growingThreshold="20">
              <columns>
                <Column width="10rem"><Text text="Feld"/></Column>
                <Column><Text text="Bezeichnung"/></Column>
                <Column><Text text="Wert"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <Text text="{m>field}"/><Text text="{m>label}"/><Text text="{m>value}"/>
                </ColumnListItem>
              </items>
            </Table>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection title="Texte" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="Kurztexte (MAKT)" titleUppercase="false">
            <Table items="{path: 'm>/texts', templateShareable: false}" growing="true" growingThreshold="10">
              <columns>
                <Column width="6rem"><Text text="Sprache"/></Column>
                <Column><Text text="Kurztext"/></Column>
              </columns>
              <items>
                <ColumnListItem><Text text="{m>SPRAS}"/><Text text="{m>MAKTX}"/></ColumnListItem>
              </items>
            </Table>
          </uxap:ObjectPageSubSection>
          <uxap:ObjectPageSubSection title="Langtexte (MTXT)" titleUppercase="false"
            visible="{= !!${m>/long_texts} &amp;&amp; ${m>/long_texts}.length > 0 }">
            <List items="{path: 'm>/long_texts', templateShareable: false}">
              <FeedListItem sender="{m>label} ({m>TDID})" text="{m>text}" showIcon="false"/>
            </List>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection title="Mengeneinheiten" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="Alternative Mengeneinheiten (MARM)" titleUppercase="false">
            <Table items="{path: 'm>/marm', templateShareable: false}" noDataText="Keine Mengeneinheiten">
              <columns>
                <Column><Text text="Einheit"/></Column>
                <Column hAlign="End"><Text text="Umrechnung"/></Column>
                <Column><Text text="EAN"/></Column>
                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="L x B x H"/></Column>
                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Volumen"/></Column>
                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Bruttogewicht"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <Text text="{m>MEINH}"/>
                  <Text text="{m>UMREZ} / {m>UMREN} {m>/meins}"/>
                  <Text text="{m>EAN11}"/>
                  <Text text="{= ${m>LAENG} ? ${m>LAENG} + ' x ' + ${m>BREIT} + ' x ' + ${m>HOEHE} + ' ' + ${m>MEABM} : '' }"/>
                  <Text text="{m>VOLUM} {m>VOLEH}"/>
                  <Text text="{m>BRGEW} {m>GEWEI}"/>
                </ColumnListItem>
              </items>
            </Table>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection title="Klassifizierung" titleUppercase="false"
        visible="{= !!${m>/mecl} &amp;&amp; ${m>/mecl}.length > 0 }">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="Klassen (MECL) und Merkmale (MEME)" titleUppercase="false">
            <VBox>
              <Table items="{path: 'm>/mecl', templateShareable: false}">
                <columns>
                  <Column><Text text="Klassenart"/></Column>
                  <Column><Text text="Klasse"/></Column>
                  <Column><Text text="Bezeichnung"/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <Text text="{m>KLART} {m>KLART_BEZEI}"/><Text text="{m>CLASS}"/><Text text="{m>CLASS_BEZEI}"/>
                  </ColumnListItem>
                </items>
              </Table>
              <Table items="{path: 'm>/meme', templateShareable: false}" class="sapUiSmallMarginTop"
                visible="{= ${m>/meme}.length > 0 }">
                <columns>
                  <Column><Text text="Klasse"/></Column>
                  <Column><Text text="Merkmal"/></Column>
                  <Column><Text text="Bezeichnung"/></Column>
                  <Column><Text text="Wert"/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <Text text="{m>CLASS}"/><Text text="{m>ATNAM}"/><Text text="{m>ATNAM_BEZEI}"/><Text text="{m>ATWRT}"/>
                  </ColumnListItem>
                </items>
              </Table>
            </VBox>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection title="Einkauf" titleUppercase="false"
        visible="{= !!${m>/eina} &amp;&amp; ${m>/eina}.length > 0 }">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="Einkaufsinfosätze (EINA)" titleUppercase="false">
            <Table items="{path: 'm>/eina', templateShareable: false}" growing="true" growingThreshold="10">
              <columns>
                <Column><Text text="Lieferant"/></Column>
                <Column><Text text="Lieferanten-Teilenr."/></Column>
                <Column><Text text="Infosatz"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Bestellmengeneinheit"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Ursprungsland"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Telefon"/></Column>
              </columns>
              <items>
                <ColumnListItem highlight="{= ${m>LOEKZ} ? 'Error' : 'None' }">
                  <Text text="{m>LIFNR}"/><Text text="{m>IDNLF}"/><Text text="{m>INFNR}"/>
                  <Text text="{m>MEINS}"/><Text text="{m>URZLA}"/><Text text="{m>TELF1}"/>
                </ColumnListItem>
              </items>
            </Table>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection id="bomSection" title="Stücklisten" titleUppercase="false" visible="{= !!${b>/has_relations} }">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="Beziehungsgraph" titleUppercase="false">
            <VBox>
              <OverflowToolbar style="Clear">
                <Label text="Verwendung" labelFor="bomUsage"/>
                <Select id="bomUsage" selectedKey="{b>/stlan}" change=".onBomFilterChange" width="12rem"
                  items="{path: 'b>/usageItems', templateShareable: false}">
                  <core:Item key="{b>key}" text="{b>text}"/>
                </Select>
                <Label text="Werk" labelFor="bomPlant"/>
                <Select id="bomPlant" selectedKey="{b>/werks}" change=".onBomFilterChange" width="10rem"
                  items="{path: 'b>/plantItems', templateShareable: false}">
                  <core:Item key="{b>key}" text="{b>text}"/>
                </Select>
                <ToolbarSpacer/>
                <Text class="mdsaStatus" text="{= ${b>/graph/nodes} ? (${b>/graph/nodes}.length + ' Materialien · links: verwendet in, rechts: Komponenten') : '' }"/>
              </OverflowToolbar>
              <MessageStrip visible="{= !!${b>/self_reference} }" type="Warning" showIcon="true" class="sapUiSmallMarginBottom"
                text="Die Stückliste enthält das Material selbst als Komponente (Zyklus) - im Graph nicht dargestellt."/>
              <MessageStrip visible="{= !!${b>/graph/truncated} }" type="Information" showIcon="true" class="sapUiSmallMarginBottom"
                text="Der Graph ist auf 150 Materialien begrenzt."/>
              <ng:Graph id="bomGraph" height="{= Math.min(Math.max((${b>/graph/widest} || 1) * 120 + 100, 320), 1600) + 'px' }" orientation="LeftRight" enableWheelZoom="false" graphReady=".onGraphReady"
                nodes="{path: 'b>/graph/nodes', templateShareable: false}" lines="{path: 'b>/graph/lines', templateShareable: false}"
                noDataText="Keine Stücklistenbeziehungen für diese Auswahl">
                <ng:layoutAlgorithm><ngl:LayeredLayout/></ng:layoutAlgorithm>
                <ng:statuses>
                  <ng:Status key="current" title="Aktuelles Material" backgroundColor="sapUiListSelectionBackgroundColor" borderColor="sapUiAccent6" borderWidth="3px"/>
                  <ng:Status key="parent" title="Verwendet in" borderColor="sapUiAccent8" backgroundColor="sapUiTileBackground"/>
                  <ng:Status key="child" title="Komponente" borderColor="sapUiAccent4" backgroundColor="sapUiTileBackground"/>
                </ng:statuses>
                <ng:nodes>
                  <ng:Node key="{b>key}" title="{b>title}" description="{b>matnr}" status="{b>role}" shape="Box"
                    width="220" titleLineSize="2" showActionLinksButton="false" showExpandButton="false"
                    icon="{= ${b>is_bom} ? 'sap-icon://tree' : 'sap-icon://product' }">
                    <ng:attributes>
                      <ng:ElementAttribute label="Material" value="{b>matnr}"/>
                    </ng:attributes>
                    <ng:actionButtons>
                      <ng:ActionButton icon="sap-icon://action" title="Material öffnen" press=".onGraphNodeOpen"/>
                    </ng:actionButtons>
                  </ng:Node>
                </ng:nodes>
                <ng:lines>
                  <ng:Line from="{b>from}" to="{b>to}" title="Menge {b>title}" description="{b>description}"/>
                </ng:lines>
              </ng:Graph>
            </VBox>
          </uxap:ObjectPageSubSection>
          <uxap:ObjectPageSubSection title="Stücklisten des Materials (STKO)" titleUppercase="false"
            visible="{= ${b>/headers_total} > 0 }">
            <Table items="{path: 'b>/headers', templateShareable: false}" noDataText="Keine Stückliste für diese Auswahl">
              <headerToolbar>
                <OverflowToolbar style="Clear">
                  <Text class="mdsaStatus" text="{= ${b>/headers}.length + ' von ' + ${b>/headers_total} + ' Stücklisten' + (${b>/stlan} || ${b>/werks} ? ' (gefiltert)' : '') }"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="Verwendung"/></Column>
                <Column><Text text="Alternative"/></Column>
                <Column><Text text="Werk"/></Column>
                <Column><Text text="Stücklistennr."/></Column>
                <Column hAlign="End"><Text text="Basismenge"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Gültig ab"/></Column>
                <Column hAlign="End"><Text text="Positionen"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <Text text="{b>stlan} {b>usage}"/><Text text="{b>stlal}"/><Text text="{= ${b>werks} || 'werksübergreifend' }"/>
                  <Text text="{b>stlnr}"/><Text text="{b>base}"/><Text text="{b>valid_from}"/><Text text="{b>items}"/>
                </ColumnListItem>
              </items>
            </Table>
          </uxap:ObjectPageSubSection>
          <uxap:ObjectPageSubSection title="Strukturstückliste (mehrstufig)" titleUppercase="false"
            visible="{= ${b>/headers_total} > 0 }">
            <t:TreeTable id="explosionTable" rows="{path: 'b>/explosion', parameters: {arrayNames: ['children']}}" selectionMode="None"
              enableColumnReordering="false" noData="Keine Positionen für diese Auswahl">
              <t:rowMode><trm:Fixed rowCount="{b>/explosionRows}"/></t:rowMode>
              <t:columns>
                <t:Column width="22rem"><Label text="Komponente"/>
                  <t:template>
                    <HBox alignItems="Center">
                      <Link text="{b>matnr}" press=".onBomMaterialPress" visible="{= !!${b>matnr} }" class="sapUiTinyMarginEnd"/>
                      <Text text="{b>text}" wrapping="false"/>
                    </HBox>
                  </t:template>
                </t:Column>
                <t:Column width="4rem"><Label text="Pos."/><t:template><Text text="{b>posnr}"/></t:template></t:Column>
                <t:Column width="9rem"><Label text="Positionstyp"/><t:template><Text text="{b>postp} {b>postp_text}" wrapping="false"/></t:template></t:Column>
                <t:Column width="6rem" hAlign="End"><Label text="Menge"/><t:template><Text text="{b>menge}"/></t:template></t:Column>
                <t:Column width="4rem"><Label text="ME"/><t:template><Text text="{b>meins}"/></t:template></t:Column>
                <t:Column width="17rem"><Label text="Stückliste (Verw. / Alt. / Werk)"/><t:template><Text text="{b>bom}" wrapping="false"/></t:template></t:Column>
                <t:Column width="9rem"><Label text="Hinweis"/>
                  <t:template>
                    <HBox>
                      <ObjectStatus text="Zyklus" state="Error" icon="sap-icon://synchronize" visible="{= !!${b>cycle} }" class="sapUiTinyMarginEnd"/>
                      <ObjectStatus text="Stückliste" state="Information" icon="sap-icon://tree" visible="{= !!${b>is_bom} &amp;&amp; !${b>cycle} }"/>
                      <ObjectStatus text="Löschvorm." state="Error" visible="{= !!${b>deleted} }"/>
                    </HBox>
                  </t:template>
                </t:Column>
              </t:columns>
            </t:TreeTable>
          </uxap:ObjectPageSubSection>
          <uxap:ObjectPageSubSection title="Verwendungsnachweis (mehrstufig)" titleUppercase="false"
            visible="{= ${m>/used_in} > 0 }">
            <t:TreeTable id="where_usedTable" rows="{path: 'b>/where_used', parameters: {arrayNames: ['children']}}" selectionMode="None"
              enableColumnReordering="false" noData="Keine Verwendung für diese Auswahl">
              <t:rowMode><trm:Fixed rowCount="{b>/whereUsedRows}"/></t:rowMode>
              <t:columns>
                <t:Column width="22rem"><Label text="Verwendet in"/>
                  <t:template>
                    <HBox alignItems="Center">
                      <Link text="{b>matnr}" press=".onBomMaterialPress" visible="{= !!${b>matnr} }" class="sapUiTinyMarginEnd"/>
                      <Text text="{b>text}" wrapping="false"/>
                    </HBox>
                  </t:template>
                </t:Column>
                <t:Column width="4rem"><Label text="Pos."/><t:template><Text text="{b>posnr}"/></t:template></t:Column>
                <t:Column width="9rem"><Label text="Positionstyp"/><t:template><Text text="{b>postp} {b>postp_text}" wrapping="false"/></t:template></t:Column>
                <t:Column width="6rem" hAlign="End"><Label text="Menge"/><t:template><Text text="{b>menge}"/></t:template></t:Column>
                <t:Column width="4rem"><Label text="ME"/><t:template><Text text="{b>meins}"/></t:template></t:Column>
                <t:Column width="17rem"><Label text="Stückliste (Verw. / Alt. / Werk)"/><t:template><Text text="{b>bom}" wrapping="false"/></t:template></t:Column>
                <t:Column width="9rem"><Label text="Hinweis"/>
                  <t:template>
                    <HBox>
                      <ObjectStatus text="Zyklus" state="Error" icon="sap-icon://synchronize" visible="{= !!${b>cycle} }" class="sapUiTinyMarginEnd"/>
                      <ObjectStatus text="Stückliste" state="Information" icon="sap-icon://tree" visible="{= !!${b>is_bom} &amp;&amp; !${b>cycle} }"/>
                      <ObjectStatus text="Löschvorm." state="Error" visible="{= !!${b>deleted} }"/>
                    </HBox>
                  </t:template>
                </t:Column>
              </t:columns>
            </t:TreeTable>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection id="duplicatesSection" title="Dubletten" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="Dublettenprüfung" titleUppercase="false">
            <VBox>
              <MessageStrip type="Information" showIcon="true" class="sapUiSmallMarginBottom"
                text="Kandidaten aus semantischer Nähe (Embeddings), unscharfem Namensvergleich und identischen Schlüsseln (EAN, Lieferanten-Teilenr.). Die KI-Bewertung per LLM unterscheidet echte Dubletten von Varianten."/>
              <MessageStrip type="Warning" showIcon="true" class="sapUiSmallMarginBottom"
                visible="{= !!${d>/candidates} &amp;&amp; !${d>/semantic_available} }"
                text="Vektorindex leer - Kandidaten nur aus Text- und Schlüsselvergleich."/>
              <MessageStrip visible="{= !!${d>/assessment} }" text="{d>/assessment/summary}" showIcon="true"
                type="{= ${d>/duplicateFound} ? 'Warning' : 'Success' }" customIcon="sap-icon://ai"
                class="sapUiSmallMarginBottom"/>
              <Table items="{path: 'd>/candidates', templateShareable: false}" busy="{d>/busy}" busyIndicatorDelay="0"
                noDataText="Keine Kandidaten gefunden">
                <headerToolbar>
                  <OverflowToolbar>
                    <Title text="Kandidaten ({= ${d>/candidates} ? ${d>/candidates}.length : 0 })" level="H3"/>
                    <ToolbarSpacer/>
                    <Button text="KI-Bewertung" icon="sap-icon://ai" type="Emphasized" press=".onAssess"
                      enabled="{= !!${/config/openai_configured} &amp;&amp; !!${d>/candidates} &amp;&amp; ${d>/candidates}.length > 0 }"
                      tooltip="Kandidaten vom LLM bewerten lassen"/>
                  </OverflowToolbar>
                </headerToolbar>
                <columns>
                  <Column width="9rem"><Text text="Material"/></Column>
                  <Column><Text text="Kurztext"/></Column>
                  <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Signale"/></Column>
                  <Column hAlign="End" width="8rem"><Text text="Ähnlichkeit"/></Column>
                  <Column minScreenWidth="Tablet" demandPopin="true"><Text text="KI-Bewertung"/></Column>
                </columns>
                <items>
                  <ColumnListItem type="Navigation" press=".onCandidatePress"
                    highlight="{= ${d>verdict/verdict} === 'Dublette' ? 'Error' : ${d>verdict/verdict} === 'Mögliche Dublette' ? 'Warning' : 'None' }">
                    <ObjectIdentifier title="{d>matnr}" text="{d>mtart} / {d>meins}"/>
                    <Text text="{d>text}"/>
                    <HBox wrap="Wrap" class="mdsaBadges">
                      <ObjectStatus text="{= ${d>shared}.join(', ') }" visible="{= ${d>shared}.length > 0 }" state="Error"
                        inverted="true" icon="sap-icon://chain-link" class="sapUiTinyMarginEnd"/>
                      <ObjectStatus visible="{= ${d>semantic} !== null }" text="{= 'Semantisch ' + Math.round(${d>semantic} * 100) + ' %' }"
                        state="Information" inverted="true" class="sapUiTinyMarginEnd"/>
                      <ObjectStatus text="{= 'Name ' + Math.round(${d>name_similarity} * 100) + ' %' }" state="Indication05"
                        inverted="true" class="sapUiTinyMarginEnd"/>
                      <ObjectStatus visible="{= !${d>same_unit} }" text="andere BME" state="Warning"/>
                    </HBox>
                    <ProgressIndicator percentValue="{d>score}" displayValue="{d>score} %" height="1.25rem"
                      state="{= ${d>score} >= 90 ? 'Error' : ${d>score} >= 75 ? 'Warning' : 'None' }"/>
                    <VBox>
                      <ObjectStatus text="{d>verdict/verdict}" visible="{= !!${d>verdict} }"
                        state="{= ${d>verdict/verdict} === 'Dublette' ? 'Error' : ${d>verdict/verdict} === 'Mögliche Dublette' ? 'Warning' : ${d>verdict/verdict} === 'Variante' ? 'Information' : 'Success' }"
                        icon="{= ${d>verdict/verdict} === 'Dublette' ? 'sap-icon://error' : '' }"/>
                      <Text text="{d>verdict/reason}" visible="{= !!${d>verdict} }" class="mdsaStatus"/>
                    </VBox>
                  </ColumnListItem>
                </items>
              </Table>
            </VBox>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection title="Suchdokument" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="Eingebetteter Text (Vektor-DB)" titleUppercase="false">
            <Text text="{m>/document}" class="mdsaDocument"/>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
    </uxap:sections>
  </uxap:ObjectPageLayout>
</mvc:View>
