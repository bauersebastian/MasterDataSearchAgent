# key of the Azure OpenAI resource (or of api.openai.com, see MDSA_OPENAI_BASE_URL)
OPENAI_API_KEY=

# optional overrides (defaults in backend/config.py)
# MDSA_OPENAI_BASE_URL=https://fisg-openai-valuestream-aoi.openai.azure.com/openai/v1/   # empty = api.openai.com
# MDSA_EMBEDDING_MODEL=text-embedding-3-large    # on Azure: the deployment name
# MDSA_EMBEDDING_DIMENSIONS=1536                 # changing it requires python -m backend.indexer --rebuild
# MDSA_MODEL=gpt-5.6-luna                        # duplicate check; on Azure: the deployment name
# MDSA_REASONING_EFFORT=low
# MDSA_LANGUAGE=D                                # SAP language of the displayed short text
# MDSA_INPUT_DIR=input
# MDSA_MATERIAL_INPUT_DIR=input/MAT
# MDSA_PARTNER_INPUT_DIR=input/GPA
# MDSA_CHROMA_DIR=data/chroma

# SAP (DXTO import web service, target = source system of the extract)
SAP_USER=
SAP_PASSWORD=
# SAP_ENDPOINT_URL=http://fis127.fis-gmbh.de:8000/sap/bc/srt/rfc/fismpm/dxto_imp_call/100/imp_master_data/s4k_100
# SAP_OPERATION=_-fismpm_-dxtoImpCall
# SAP_SOAP_ACTION=
# SAP_REQUEST_TIMEOUT=120
# SAP_LOGON_LANGUAGE=DE                 # logon language of the call (sap-language + Accept-Language)
# SAP_VARIANT=BRUNO
# SAP_VIA_JOB=X
# SAP_JOB_NAME=
# SAP_KEY_FIELD=MATNR                  # MATNR = change the existing material, MATFS = create a new one
# SAP_PARTNER_KEY_FIELD=PARTNER
# SAP_PARTNER_VARIANT=BRUNO_GPA
# live checks via the standard OData APIs (deletion check, read only, same user)
# SAP_CLIENT=100
# SAP_ODATA_URL=http://fis127.fis-gmbh.de:8000/sap/opu/odata/sap

# golden record (merge of duplicates): log of the merges and block reasons set with the customer block
# MDSA_MERGE_DB=data/merges.sqlite
# MDSA_USAGE_DB=data/usage.sqlite      # token consumption of the OpenAI calls (page /usage.html)
# MDSA_USAGE_TIMEZONE=Europe/Berlin     # day / week / month of the consumption begin at midnight of this zone
# MDSA_MERGE_ORDER_BLOCK=01            # KNA1-AUFSD, empty = not set
# MDSA_MERGE_DELIVERY_BLOCK=01         # KNA1-LIFSD
# MDSA_MERGE_BILLING_BLOCK=01          # KNA1-FAKSD
# MDSA_MERGE_SALES_BLOCK=              # KNA1-CASSD
# MDSA_MERGE_CHECK_MAX_AGE=3600        # seconds; an older deletion check is repeated before sending
